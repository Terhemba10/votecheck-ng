# Copy this file to .env and fill in what you need. Never commit .env.
ANTHROPIC_API_KEY=your-key-here
MODEL=claude-haiku-5-5
PORT=3000

# Google sign-in. Leave GOOGLE_CLIENT_ID empty to run in open demo mode.
# Create an OAuth "Web application" client in Google Cloud Console and add
# http://localhost:3000 and your live site as authorised JavaScript origins.
GOOGLE_CLIENT_ID=
# Any long random string. It signs the session cookie.
SESSION_SECRET=
